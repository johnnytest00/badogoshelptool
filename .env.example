# Publikus Supabase kliensbeállítások (F2.2 Auth-integrációhoz).
# Ezeket lokálisan .env.local fájlban add meg, valódi értékek nélkül commitolj.
NEXT_PUBLIC_SUPABASE_URL=http://192.168.1.114:54321 # http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key

# Soha ne kerüljön böngésző-kódba vagy verziókezelt fájlba:
# SUPABASE_SERVICE_ROLE_KEY=
